# 환경 변수 템플릿
# .env.example을 .env로 복사하여 사용하세요

# Upstage AI API Key
UPSTAGE_API_KEY=your-upstage-api-key-here

# Database (로컬 개발용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rebuy
DB_USER=rebuy_user
DB_PASSWORD=rebuy_password

# JWT Secret
JWT_SECRET=rebuy-secret-key-for-jwt-token-generation-2024-change-this-in-prod-very-long-string-xyz

